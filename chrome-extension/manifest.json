{
  "manifest_version": 3,
  "name": "HugCivi Remote",
  "version": "0.1.0",
  "description": "Send the current tab or a typed input to a HugCivi server.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "HugCivi Remote",
    "default_icon": {
      "16": "icons/hugcivi-16.png",
      "32": "icons/hugcivi-32.png",
      "48": "icons/hugcivi-48.png",
      "128": "icons/hugcivi-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "send-current-url": {
      "suggested_key": {
        "default": "Alt+Shift+H",
        "mac": "Alt+Shift+H"
      },
      "description": "Send current tab URL to HugCivi"
    }
  },
  "icons": {
    "16": "icons/hugcivi-16.png",
    "32": "icons/hugcivi-32.png",
    "48": "icons/hugcivi-48.png",
    "128": "icons/hugcivi-128.png"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "permissions": [
    "notifications",
    "storage",
    "tabs"
  ]
}
